flowchart LR
    U[User] --> CLI[CLI Layer\nCommands: add/list/budget/report/settings]

    subgraph ENTRY["Entrypoint Wiring"]
        BOOT[Bootstrap / Composition Root\nResolve data dir\nOpen SQLite\nBuild repos/use cases/server]
    end

    subgraph TRANSPORT["Transport Layer"]
        CLIENT[HTTP Client\nSerialize CLI input to JSON\nDeserialize server response]
        SERVER[HTTP Server\nREST API Handlers\nJSend Response Format\nlocalhost only]
    end

    subgraph APP["Application Layer"]
        direction TB
        VAL[Validation Module\nAmount / Date / Month / Category / Timezone]
        TX[Transaction Use Case]
        CAT[Category Use Case]
        BUD[Budget Use Case]
        REP[Report Use Case]
        SET[Settings Use Case]
        TIME[Time and Timezone Utility]
    end

    subgraph DOMAIN["Domain Layer"]
        ENT[Entities\nTransaction / Category / Budget / Settings / Report]
        VO[Value Objects\nEntryType / CategoryKey / ULID]
        DERR[Domain Errors\nINVALID_AMOUNT / INVALID_DATE / etc.]
    end

    %% PORTS sits at the boundary between Application/Domain and Infrastructure.
    subgraph PORTS["Output Port Interfaces (Application Layer Boundary)"]
        TREPO[(Transaction Repository)]
        CREPO[(Category Repository)]
        BREPO[(Budget Repository)]
        IREPO[(Initial Balance Repository)]
        SREPO[(Settings Repository)]
    end

    subgraph PERSIST["Persistence Layer - Local Only"]
        REPO[Repository Implementations\nImplements output port interfaces]
        STORE[(SQLite Local DB\nOn-device)]
    end

    CLI --> BOOT
    BOOT --> CLIENT
    BOOT --> SERVER
    CLIENT --> SERVER

    SERVER --> TX
    SERVER --> CAT
    SERVER --> BUD
    SERVER --> REP
    SERVER --> SET

    TX --> VAL
    CAT --> VO
    BUD --> VAL
    REP --> VAL
    REP --> TIME
    SET --> VAL

    TX --> TREPO
    TX --> CREPO
    CAT --> CREPO
    BUD --> BREPO
    BUD --> CREPO
    REP --> TREPO
    REP --> IREPO
    SET --> SREPO
    SET --> IREPO

    TREPO --> REPO
    CREPO --> REPO
    BREPO --> REPO
    IREPO --> REPO
    SREPO --> REPO
    REPO --> STORE

    SET -. analyticsOptIn .-> ANA
    ANA -. emits anonymous events only .-> SERVER
